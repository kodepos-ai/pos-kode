---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/kode-pos.css";

const API_BASE =
  "https://api-kodepos.linkq.workers.dev/api/kode-pos";

const q = (Astro.url.searchParams.get("q") || "").trim();

let results = [];
let error = "";

if (q.length >= 2) {
  try {
    const res = await fetch(
      `${API_BASE}/search?q=${encodeURIComponent(q)}`
    );

    if (!res.ok) {
      throw new Error(`API HTTP ${res.status}`);
    }

    const json = await res.json();
    const data = json.data || [];

    /*
     * API mengembalikan data sampai level kelurahan/desa.
     * Untuk halaman Sedot WC kita hanya membutuhkan
     * satu hasil untuk setiap kecamatan.
     */
    const districts = new Map();

    for (const item of data) {
      const key = `${item.prov_id}-${item.city_id}-${item.dis_id}`;

      if (!districts.has(key)) {
        districts.set(key, item);
      }
    }

    results = [...districts.values()];
  } catch (e) {
    console.error("SEDOT WC SEARCH ERROR:", e);
    error = "Gagal mengambil data pencarian.";
  }
}

const title = q
  ? `Cari Sedot WC ${q}`
  : "Sedot WC Indonesia";

const description =
  "Cari jasa sedot WC berdasarkan provinsi, kabupaten, kota, kecamatan, atau wilayah di Indonesia.";
---

<MainLayout
  title={title}
  description={description}
  canonical={Astro.url.href}
>
  <main class="kode-pos-page">
    <div class="kode-pos-container">

      <!-- Breadcrumb -->

      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >
        <a href="/">Beranda</a>
        <span>/</span>
        <span>Sedot WC</span>
      </nav>


      <!-- Header -->

      <header class="page-heading">

        <span class="eyebrow">
          Jasa Sedot WC
        </span>

        <h1>
          Sedot WC Indonesia
        </h1>

        <p>
          Cari layanan sedot WC berdasarkan
          provinsi, kabupaten, kota, kecamatan,
          atau wilayah di sekitar Anda.
        </p>

      </header>


      <!-- Search -->

      <section class="content-section">

        <form
          method="get"
          action="/sedot-wc/"
          class="kodepos-search"
          role="search"
        >

          <input
            type="search"
            name="q"
            value={q}
            placeholder="Cari kota atau kecamatan..."
            autocomplete="off"
            minlength="2"
            required
            aria-label="Cari wilayah sedot WC"
          />

          <button type="submit">
            Cari
          </button>

        </form>

      </section>


      <!-- Results -->

      {
        q ? (

          <section class="content-section">

            <div class="section-heading">

              <div>

                <span class="eyebrow">
                  Hasil Pencarian
                </span>

                <h2>
                  Wilayah Sedot WC
                </h2>

              </div>

              {
                results.length > 0 && (
                  <span class="count">
                    {results.length} wilayah
                  </span>
                )
              }

            </div>


            {
              error ? (

                <div class="empty-state">
                  {error}
                </div>

              ) : results.length > 0 ? (

                <div class="list-grid">

                  {
                    results.map((item) => (

                      <a
                        class="list-card"
                        href={`/sedot-wc/${slugify(item.prov_name)}/${slugify(item.city_name)}/${slugify(item.dis_name)}/`}
                      >

                        <span>

                          <strong>
                            Sedot WC {item.dis_name}
                          </strong>

                          <small>
                            Kecamatan {item.dis_name},{" "}
                            {item.city_name},{" "}
                            {item.prov_name}
                          </small>

                        </span>

                        <span class="arrow">
                          →
                        </span>

                      </a>

                    ))
                  }

                </div>

              ) : (

                <div class="empty-state">

                  Tidak ditemukan wilayah untuk
                  pencarian <strong>{q}</strong>.

                </div>

              )
            }

          </section>

        ) : (

          <section class="content-section">

            <div class="empty-state">

              <h2>
                Cari Wilayah
              </h2>

              <p>
                Masukkan nama kota atau kecamatan
                untuk menemukan halaman layanan
                sedot WC di wilayah tersebut.
              </p>

            </div>

          </section>

        )
      }

    </div>
  </main>
</MainLayout>


---

<script>
  function slugify(value) {
    return String(value)
      .toLowerCase()
      .trim()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }
</script>
