---
import MainLayout from "../../../../../layouts/MainLayout.astro";
import "../../../../../styles/kode-pos.css";
import {
  getProvinces,
  getCities,
  getDistricts,
  getPostalCodes,
} from "../../../../../lib/kode-pos/config";

export const prerender = false;

const { provinsi, kota, kecamatan } = Astro.params;
const provinces = await getProvinces();
const province = provinces.find((item) => item.slug === provinsi);

if (!province) return new Response("Provinsi tidak ditemukan", { status: 404 });

const cities = await getCities(Astro.locals, province.prov_id);
const city = cities.find((item) => item.slug === kota);

if (!city) return new Response("Kabupaten / kota tidak ditemukan", { status: 404 });

const districts = await getDistricts(Astro.locals, city.city_id);
const district = districts.find((item) => item.slug === kecamatan);

if (!district) return new Response("Kecamatan tidak ditemukan", { status: 404 });

const postalCodes = await getPostalCodes(Astro.locals, district.dis_id);


const title = `Kode Pos ${district.name}, ${city.name}, ${province.name}`;

const descriptions = [
  `Daftar kode pos ${district.name}, ${city.name}, ${province.name} lengkap berdasarkan kelurahan dan desa. Temukan kode pos setiap wilayah dengan mudah.`,

  `Temukan kode pos ${district.name}, ${city.name}, ${province.name} berdasarkan kelurahan dan desa yang tersedia lengkap dalam satu halaman.`,

  `Informasi kode pos ${district.name}, ${city.name}, ${province.name} mencakup daftar kelurahan dan desa beserta kode pos masing-masing wilayah.`,

  `Cari kode pos wilayah ${district.name}, ${city.name}, ${province.name} dengan melihat daftar kelurahan dan desa beserta kode posnya.`,

  `Daftar kelurahan, desa, dan kode pos ${district.name}, ${city.name}, ${province.name} untuk membantu menemukan kode pos wilayah dengan cepat.`,

  `Lihat daftar kode pos ${district.name}, ${city.name}, ${province.name} lengkap dengan nama kelurahan dan desa di setiap wilayah.`,

  `Panduan kode pos ${district.name}, ${city.name}, ${province.name} berisi daftar kelurahan dan desa beserta informasi kode pos yang tersedia.`,

  `Cari informasi kode pos di ${district.name}, ${city.name}, ${province.name} mulai dari kelurahan hingga desa dalam daftar yang mudah digunakan.`,

  `Daftar kode pos wilayah ${district.name}, ${city.name}, ${province.name} mencakup kelurahan dan desa untuk memudahkan pencarian kode pos.`,

  `Temukan informasi kode pos ${district.name}, ${city.name}, ${province.name} secara praktis melalui daftar kelurahan dan desa beserta kode posnya.`
];

const descriptionIndex =
  [...district.name].reduce(
    (total, char) => total + char.charCodeAt(0),
    0
  ) % descriptions.length;

const description = descriptions[descriptionIndex];
---
<MainLayout title={title} description={description} canonical={Astro.url.href}>
  <main class="kode-pos-page">
    <div class="kode-pos-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/kode-pos/">Kode Pos</a><span>/</span>
        <a href={`/kode-pos/${province.slug}/`}>{province.name}</a><span>/</span>
        <a href={`/kode-pos/${province.slug}/${city.slug}/`}>{city.name}</a><span>/</span>
        <span>{district.name}</span>
      </nav>

      <header class="page-heading">
        <span class="eyebrow">Kecamatan</span>
        <h1>Kode Pos {district.name}</h1>
        <p>Daftar kode pos {district.name}, {city.name}, {province.name}.</p>
      </header>

      <section class="content-section">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Kelurahan / Desa</span>
            <h2>Daftar Kode Pos</h2>
          </div>
          <span class="count">{postalCodes.length} data</span>
        </div>

        {postalCodes.length > 0 ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Kelurahan / Desa</th>
                  <th scope="col">Kode Pos</th>
                </tr>
              </thead>
              <tbody>
                {postalCodes.map((item) => (
                  <tr>
                    <td>{item.name}</td>
                    <td><span class="postal-code">{item.postal_code}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">Data kode pos tidak tersedia.</div>
        )}
      </section>
    </div>
  </main>
</MainLayout>
