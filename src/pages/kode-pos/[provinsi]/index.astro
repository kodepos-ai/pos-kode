  "sulawesi-tengah":
    "Temukan kode pos Sulawesi Tengah berdasarkan kabupaten, kota, kecamatan, hingga kelurahan atau desa di seluruh wilayah.",

  "sulawesi-selatan":
    "Cari kode pos Sulawesi Selatan untuk Makassar, Gowa, Bone, Maros, Parepare, dan berbagai wilayah lainnya.",

  "sulawesi-tenggara":
    "Lihat kode pos Sulawesi Tenggara berdasarkan Kendari, Baubau, Konawe, Kolaka, serta kabupaten dan kecamatan lainnya.",

  "gorontalo":
    "Temukan kode pos Gorontalo berdasarkan kabupaten dan kota, kecamatan, serta kelurahan dan desa di seluruh wilayah.",

  "sulawesi-barat":
    "Cari kode pos Sulawesi Barat berdasarkan kabupaten, kecamatan, hingga kelurahan atau desa di setiap wilayah.",

  "maluku":
    "Temukan kode pos Maluku berdasarkan Ambon dan berbagai kabupaten serta kecamatan yang tersebar di wilayah kepulauan Maluku.",

  "maluku-utara":
    "Cari kode pos Maluku Utara berdasarkan Ternate, Tidore, Halmahera, serta berbagai kabupaten dan kecamatan lainnya.",

  "papua":
    "Lihat daftar kode pos Papua berdasarkan kabupaten, kecamatan, serta kelurahan atau desa di berbagai wilayah Papua.",

  "papua-barat":
    "Temukan kode pos Papua Barat berdasarkan kabupaten, kecamatan, dan kelurahan atau desa untuk membantu pencarian alamat."
};

const description =
  provinceDescriptions[province.slug] ||
  `Informasi kode pos ${province.name} berdasarkan kabupaten, kota, kecamatan, dan kelurahan atau desa.`;

const title = `Kode Pos ${province.name}`;
---

<MainLayout
  title={title}
  description={description}
  canonical={Astro.url.href}
>
  <main class="kode-pos-page">
    <div class="kode-pos-container">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span>/</span>
        <a href="/kode-pos/">Kode Pos</a>
        <span>/</span>
        <span>{province.name}</span>
      </nav>

      <header class="page-heading">
        <span class="eyebrow">
          Kode Pos {province.name}
        </span>

        <h1>Kode Pos {province.name}</h1>

        <p>
          {description}
        </p>
      </header>

      <section
        class="content-section"
        aria-labelledby="city-list"
      >

        <div class="section-heading">
          <div>
            <h2 id="city-list">
              Kabupaten dan Kota
            </h2>
          </div>

          <span class="count">
            {cities.length} wilayah
          </span>
        </div>

        {cities.length > 0 ? (
          <div class="region-grid">
            {cities.map((city, index) => (
              <a
                class="region-card"
                href={kodePosUrl(
                  province.slug,
                  city.slug
                )}
              >
                <span class="region-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="region-info">
                  <strong>{city.name}</strong>

                  <small>
                    Lihat kecamatan dan kode pos
                  </small>
                </span>

                <span
                  class="arrow"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            Data kabupaten dan kota untuk {province.name}
            belum tersedia.
          </div>
        )}

      </section>

    </div>
  </main>
</MainLayout>
