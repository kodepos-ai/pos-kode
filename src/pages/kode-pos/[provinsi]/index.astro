---
import MainLayout from "../../../layouts/MainLayout.astro";
import "../../../styles/kode-pos.css";
import {
  getProvinces,
  getCities,
  kodePosUrl,
} from "../../../lib/kode-pos/config";

export const prerender = false;

const { provinsi } = Astro.params;

const provinces = await getProvinces();

const province = provinces.find(
  (item) => item.slug === provinsi
);

if (!province) {
  return new Response(
    `Provinsi tidak ditemukan`,
    {
      status: 404,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
      },
    }
  );
}

const cities = await getCities(
  Astro.locals,
  province.prov_id
);

/*
 * Deskripsi SEO khusus setiap provinsi.
 * Tidak random sehingga hasilnya selalu sama
 * ketika halaman di-refresh.
 */
const provinceDescriptions: Record<string, string> = {
  "aceh":
    "Temukan kode pos Aceh berdasarkan kabupaten, kota, kecamatan, hingga kelurahan dan desa. Lihat daftar wilayah untuk menemukan kode pos yang sesuai.",

