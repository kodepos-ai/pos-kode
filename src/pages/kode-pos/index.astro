---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/kode-pos.css";
import { getProvinces, kodePosUrl } from "../../lib/kode-pos/config";

const provinces = await getProvinces();

const title = "Kode Pos Indonesia";
const description =
  "Cari kode pos Indonesia berdasarkan provinsi, kabupaten, kota, kecamatan, dan kelurahan.";
---

<MainLayout title={title} description={description}>
  <main class="kode-pos-page">
    <div class="kode-pos-container">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span>/</span>
        <span>Kode Pos</span>
      </nav>

      <header class="page-heading">
        <span class="eyebrow">Kode Pos Indonesia</span>

        <h1>Kode Pos Indonesia</h1>

        <p>
          Pilih provinsi untuk mencari kode pos berdasarkan wilayah.
        </p>
      </header>

      <section class="content-section" aria-labelledby="province-list">

        <div class="section-heading">
          <div>
            <h2 id="province-list">Pilih Provinsi</h2>
          </div>

          <span class="count">
            {provinces.length} provinsi
          </span>
        </div>

        {provinces.length > 0 ? (
          <div class="region-grid">
            {provinces.map((province, index) => (
              <a
                class="region-card"
                href={kodePosUrl(province.slug)}
              >
                <span class="region-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="region-info">
                  <strong>{province.name}</strong>
                  <small>Lihat kabupaten dan kota</small>
                </span>

                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            Data provinsi belum tersedia.
          </div>
        )}

      </section>

    </div>
  </main>
</MainLayout>
